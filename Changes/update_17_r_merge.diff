+event bool ListRowActivated(Window list, int rowId)
+{
+	if (bIsCharSelector && list == lstOptions)
+	{
+		ApplyCurrentStateToPlayer();
+		return True;
+	}
+	return Super.ListRowActivated(list, rowId);
+}
